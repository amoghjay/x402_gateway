.env
venv/
__pycache__/
*.pyc
DEMO_NOTES.md
.pytest_cache/
.ruff_cache/
PLAN-v2.md

# Go build output and coverage.
/bin/
*.out
*.test

# Terraform working state. State itself lives in a GCS backend, never in git.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example

# Legacy Foundry build output. Untracked deliberately: `git rm --cached` alone does
# not stick, since the files remain on disk and any `git add -A` re-adds them.
# payment.py reads contracts/abi/InferenceEscrow.json instead — see sync-abi.sh.
legacy/llm-gateway/contracts/out/
legacy/llm-gateway/contracts/cache/

# forge script writes a per-chain deployment record under broadcast/. Real-chain
# records are kept on purpose — they are the provenance the original hand-deploy
# never produced. Only local noise is ignored: 31337 is anvil, and dry-run/ is
# output from invocations that never broadcast.
legacy/llm-gateway/contracts/broadcast/*/31337/
legacy/llm-gateway/contracts/broadcast/**/dry-run/
.envrc

# Terraform backend config carries the project ID; kept out of the public repo.
deploy/terraform/backend.hcl
