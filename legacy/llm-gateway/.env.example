# Copy to .env and fill the four values marked FILL ME. Everything else is
# public chain data and is prefilled with the values this project was demoed
# against, so a fresh clone runs without hunting for addresses.
#
#   cp .env.example .env
#
# .env is gitignored. Never commit real keys.

# --- FILL ME (4) ------------------------------------------------------------

# https://console.groq.com/keys
GROQ_API_KEY=

# Test wallet that pays for inference. Needs SBC (for the charge) and native
# currency (for gas on deposit/approve). Hex, 0x-prefixed.
WALLET_KEY=

# Gateway operator wallet that submits InferenceEscrow.settle(). MUST be a
# different wallet from WALLET_KEY: the contract requires msg.sender ==
# auth.settler, so a payer signing for itself proves nothing about who may
# redeem the authorization. Needs native currency for gas, no SBC.
GATEWAY_OPERATOR_KEY=

# Address that receives payment. This is `payTo` / `witness.to` on Path A and
# the immutable `provider` on Path B, so changing it means redeploying the
# escrow. Typically the address derived from GATEWAY_OPERATOR_KEY.
PAY_TO_ADDRESS=

# --- Chain and facilitator (Radius testnet) ---------------------------------

RPC_URL=https://rpc.testnet.radiustech.xyz
CHAIN_ID=72344
FACILITATOR_URL=https://facilitator.testnet.radiustech.xyz

# --- Canonical contracts on this chain --------------------------------------

# Stable Coin, 6 decimals. The asset both paths move.
SBC_CONTRACT_ADDRESS=0x33ad9e4BD16B69B5BFdED37D8B5D9fF9aba014Fb
# Permit2, same address on every chain that has it.
PERMIT2_CONTRACT_ADDRESS=0x000000000022D473030F116dDEE9F6B43aC78BA3
# x402 proxy: the `spender` the payer signs over on Path A.
X402_PROXY_ADDRESS=0x402085c248EeA27D92E8b30b2C58ed07f9E20001

# --- Path B: InferenceEscrow -----------------------------------------------

# Deployed with token=SBC_CONTRACT_ADDRESS, provider=PAY_TO_ADDRESS (both
# verified on-chain). Redeploy with: forge script script/Deploy.s.sol
ESCROW_CONTRACT_ADDRESS=0x76c03C8b763a0e2f3594bABfb71847e8a6d502D8

# --- Pricing ---------------------------------------------------------------

# Price per inference in SBC base units. SBC has 6 decimals, so 1000 = 0.001 SBC.
PRICE_BASE_UNITS=1000

# --- Provider --------------------------------------------------------------

# Read by llm.py. NOTE: currently unused — llm.py hardcodes the model. Wired up
# in the Settings refactor; kept here so .env and .env.example stay in step.
GROQ_MODEL=llama-3.3-70b-versatile
