# Copy to .env and fill in. docker compose reads .env from this directory.

# The wallet payments go to: any EVM address you control. Required.
PAY_TO=

# The API the gate protects. The default is the demo backend in compose.yaml; for an API
# on this machine outside Docker use host.docker.internal and its port.
UPSTREAM_HOST=httpbin
UPSTREAM_PORT=8080

# Only for compose.platform.yaml: a Radius Platform project whose policy governs the
# route "platform", and a file holding its connector key (from the project's Gate page).
PLATFORM_ORG=
PLATFORM_PROJECT=
PLATFORM_KEY_FILE=
